* {
  font-family: "Ubuntu Nerd Font";
  font-size: 12px;
  color: #ffffff;
}

window#waybar {
  background: rgba(0, 0, 0, 0.50);
  border: 1.2px solid #20D2D7;
  border-radius: 20px;
  box-shadow: 0px 0px 1px 0.2px #00ffff;
}

/* Transparent modules */
#custom-launcher,
#clock,
#cpu,
#custom-volume_bar,
#network,
#bluetooth,
#custom-battery_bar,
#tray {
  background: transparent;
  padding: 0 6px;
  margin: 2px 0;
  border-radius: 10px;
}

/* Tight right block spacing */
.modules-right #cpu,
.modules-right #custom-volume_bar,
.modules-right #network,
.modules-right #bluetooth,
.modules-right #custom-battery_bar,
.modules-right #tray {
  padding-left: 4px;
  padding-right: 4px;
  margin: 0;
}

#custom-volume_bar,
#custom-battery_bar {
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 14px;
}

/* Volume colors */
#custom-volume_bar.warning { color: #f1c40f; }
#custom-volume_bar.critical { color: #e74c3c; }
#custom-volume_bar.muted { color: #888888; }

/* Battery colors */
#custom-battery_bar.warning { color: #f1c40f; }
#custom-battery_bar.critical { color: #e74c3c; }

#temperature {
  padding: 0 10px;
  margin: 0 4px;
  border-radius: 12px;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(32, 210, 215, 0.5);
  font-weight: 600;
}

#temperature:hover {
  background: rgba(0, 0, 0, 0.5);
  border-color: rgba(32, 210, 215, 0.8);
}

#temperature.critical {
  border-color: rgba(255, 80, 80, 0.8);
}

#custom-gpu-temp {
  padding: 0 10px;
  margin: 0 4px;
  border-radius: 12px;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(32, 210, 215, 0.5);
  font-weight: 600;
}

#custom-gpu-temp:hover {
  background: rgba(0, 0, 0, 0.50);
  border-color: rgba(32, 210, 215, 0.8);
}

#custom-gpu-temp.high {
  border-color: rgba(255, 180, 80, 0.8);
}

#custom-gpu-temp.critical {
  border-color: rgba(255, 80, 80, 0.85);
}

.modules-left {
  margin-left: 15px;
}

/* =========================================================
   WORKSPACES SPLIT + SMALL "o o o" DOTS (GTK-safe, clean)
   Center layout:
     left  = 1..5
     middle= RAZGON
     right = 6..10
   ========================================================= */

/* LEFT instance: hide buttons after the 5th */
#workspaces.left button:nth-child(n+6) {
  opacity: 0;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: 0;
  background-image: none;
}

/* RIGHT instance: collapse ALL buttons by default (prevents gaps) */
#workspaces.right button {
  opacity: 0;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: 0;
  background-image: none;
}

/* RIGHT instance: re-enable ONLY persistent buttons (6..10) */
#workspaces.right button.persistent {
  opacity: 1;
}

/* Hide numeric labels */
#workspaces.left .workspace-label,
#workspaces.right .workspace-label {
  font-size: 0;
}

/* Base dot style (LEFT all buttons, RIGHT persistent only) */
#workspaces.left button,
#workspaces.right button.persistent {
  box-shadow: none;
  border-image: none;
  outline: none;
  background-color: transparent;
  border: 0;

  padding: 0;
  margin: 0 4px;            /* spacing between dots */
  min-width: 12px;          /* clickable area */
  min-height: 12px;

  background-repeat: no-repeat;
  background-position: center;
  background-size: 8px 8px; /* dot size */
}

/* Hollow circle (inactive) */
#workspaces.left button,
#workspaces.right button.persistent {
  background-image: radial-gradient(circle at center,
    transparent 0px,
    transparent 2px,
    rgba(32, 210, 215, 0.75) 2px,
    rgba(32, 210, 215, 0.75) 3px,
    transparent 3px
  );
}

/* Filled circle (active) */
#workspaces.left button.active,
#workspaces.right button.active.persistent {
  background-image: radial-gradient(circle at center,
    rgba(255, 255, 255, 0.95) 0px,
    rgba(255, 255, 255, 0.95) 3px,
    transparent 3px
  );
}

#custom-center-text.normal {
  padding: 0 14px;
  border-radius: 14px;
  background: rgba(0, 255, 255, 0.08);
  color: #ffffff;
  font-weight: 700;
  letter-spacing: 1px;
  box-shadow: 0 0 6px rgba(32,210,215,0.6);
}

#custom-center-text.gaming {
  padding: 0 14px;
  border-radius: 14px;
  background: rgba(53, 132, 228, 0.2);
  color: #ffffff;
  font-weight: 700;
  letter-spacing: 1.5px;
  box-shadow: 0 0 10px rgba(53,132,228,0.9);
  font-size: 15px;
}
@keyframes gaming-glow {
  0% { box-shadow: 0 0 6px rgba(53,132,228,0.6); }
  50% { box-shadow: 0 0 14px rgba(53,132,228,1); }
  100% { box-shadow: 0 0 6px rgba(53,132,228,0.6); }
}

#custom-center-text.gaming {
  animation: gaming-glow 2s infinite ease-in-out;
}


#custom-center-text {
  transition: all 200ms ease;
}



#custom-cava {
  font-family: "JetBrainsMono Nerd Font Mono", monospace;
  font-size: 14px;
}

#custom-submap {
  font-weight: 700;
  padding: 0 10px;
}
