	
# ==========================
# HYPRLAND MAIN LOADER FILE
# ==========================

$mainMod = SUPER
$terminal = kitty
$fileManager = thunar
$menu = rofi -show drun

## Hardware / monitors first
source = ~/.config/hypr/user-settings/monitors.conf

## Environment variables
source = ~/.config/hypr/user-settings/env.conf

## Autostart programsss
source = ~/.config/hypr/user-settings/autostart.conf

## Input devices
source = ~/.config/hypr/user-settings/input.conf

## Look & Feel
source = ~/.config/hypr/user-settings/theme.conf

## Window / workspace rules
source = ~/.config/hypr/user-settings/windowrules.conf

## Keybindings
source = ~/.config/hypr/user-settings/binds.conf

## Gamemode
source = ~/.config/hypr/user-settings/gamemode.conf

 
## Switch KB Layout (After Game Mode)
source = ~/.config/hypr/user-settings/kblayout.conf



## Workspaces
source = ~/.config/hypr/user-settings/workspaces-demeter.conf

# Quickshell lockscreen preview only
bind = SUPER_SHIFT, L, exec, ~/.config/hypr/scripts/qs-lock-preview.sh
