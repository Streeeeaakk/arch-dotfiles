# Office PC workspace layout
# 4 workspaces per monitor

# Laptop/Main workspace variables
$ws_laptop_1 = 1
$ws_laptop_2 = 2
$ws_laptop_3 = 3
$ws_laptop_4 = 4

# HDMI workspace variables
$ws_hdmi_1 = 5
$ws_hdmi_2 = 6
$ws_hdmi_3 = 7
$ws_hdmi_4 = 8

# Assign workspaces to monitors
workspace = $ws_laptop_1, monitor:$monitor_laptop
workspace = $ws_laptop_2, monitor:$monitor_laptop
workspace = $ws_laptop_3, monitor:$monitor_laptop
workspace = $ws_laptop_4, monitor:$monitor_laptop

workspace = $ws_hdmi_1, monitor:$monitor_hdmi
workspace = $ws_hdmi_2, monitor:$monitor_hdmi
workspace = $ws_hdmi_3, monitor:$monitor_hdmi
workspace = $ws_hdmi_4, monitor:$monitor_hdmi

# Switch main monitor workspaces
bind = $mainMod, 1, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_laptop_1
bind = $mainMod, 2, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_laptop_2
bind = $mainMod, 3, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_laptop_3
bind = $mainMod, 4, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_laptop_4

# Switch HDMI workspaces
bind = $mainMod, F1, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_hdmi_1
bind = $mainMod, F2, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_hdmi_2
bind = $mainMod, F3, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_hdmi_3
bind = $mainMod, F4, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_hdmi_4

# Move window to main monitor workspaces
bind = $mainMod SHIFT, 1, movetoworkspace, $ws_laptop_1
bind = $mainMod SHIFT, 2, movetoworkspace, $ws_laptop_2
bind = $mainMod SHIFT, 3, movetoworkspace, $ws_laptop_3
bind = $mainMod SHIFT, 4, movetoworkspace, $ws_laptop_4

# Move window to HDMI workspaces
bind = $mainMod SHIFT, F1, movetoworkspace, $ws_hdmi_1
bind = $mainMod SHIFT, F2, movetoworkspace, $ws_hdmi_2
bind = $mainMod SHIFT, F3, movetoworkspace, $ws_hdmi_3
bind = $mainMod SHIFT, F4, movetoworkspace, $ws_hdmi_4
