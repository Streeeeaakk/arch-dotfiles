# Office PC workspace layout
# 3 monitors, 4 workspaces each

$monitor_main = HDMI-A-3
$monitor_second = HDMI-A-2
$monitor_third = HDMI-A-1

# Main monitor: 1-4
$ws_main_1 = 1
$ws_main_2 = 2
$ws_main_3 = 3
$ws_main_4 = 4

# Second monitor: 5-8
$ws_second_1 = 5
$ws_second_2 = 6
$ws_second_3 = 7
$ws_second_4 = 8

# Third monitor: 9-12
$ws_third_1 = 9
$ws_third_2 = 10
$ws_third_3 = 11
$ws_third_4 = 12

# Assign workspaces to monitors
workspace = $ws_main_1, monitor:$monitor_main
workspace = $ws_main_2, monitor:$monitor_main
workspace = $ws_main_3, monitor:$monitor_main
workspace = $ws_main_4, monitor:$monitor_main

workspace = $ws_second_1, monitor:$monitor_second
workspace = $ws_second_2, monitor:$monitor_second
workspace = $ws_second_3, monitor:$monitor_second
workspace = $ws_second_4, monitor:$monitor_second

workspace = $ws_third_1, monitor:$monitor_third
workspace = $ws_third_2, monitor:$monitor_third
workspace = $ws_third_3, monitor:$monitor_third
workspace = $ws_third_4, monitor:$monitor_third

# Switch main monitor workspaces
bind = $mainMod, 1, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_main_1
bind = $mainMod, 2, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_main_2
bind = $mainMod, 3, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_main_3
bind = $mainMod, 4, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_main_4

# Switch second monitor workspaces
bind = $mainMod, F1, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_second_1
bind = $mainMod, F2, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_second_2
bind = $mainMod, F3, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_second_3
bind = $mainMod, F4, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_second_4

# Switch third monitor workspaces / HDMI-A-1
bind = $mainMod, 6, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_third_1
bind = $mainMod, 7, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_third_2
bind = $mainMod, 8, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_third_3
bind = $mainMod, 9, exec, ~/.config/hypr/scripts/qs-workspace.sh $ws_third_4

# Move window to main monitor workspaces
bind = $mainMod SHIFT, 1, movetoworkspace, $ws_main_1
bind = $mainMod SHIFT, 2, movetoworkspace, $ws_main_2
bind = $mainMod SHIFT, 3, movetoworkspace, $ws_main_3
bind = $mainMod SHIFT, 4, movetoworkspace, $ws_main_4

# Move window to second monitor workspaces
bind = $mainMod SHIFT, F1, movetoworkspace, $ws_second_1
bind = $mainMod SHIFT, F2, movetoworkspace, $ws_second_2
bind = $mainMod SHIFT, F3, movetoworkspace, $ws_second_3
bind = $mainMod SHIFT, F4, movetoworkspace, $ws_second_4

# Move window to third monitor workspaces / HDMI-A-1
bind = $mainMod SHIFT, 6, movetoworkspace, $ws_third_1
bind = $mainMod SHIFT, 7, movetoworkspace, $ws_third_2
bind = $mainMod SHIFT, 8, movetoworkspace, $ws_third_3
bind = $mainMod SHIFT, 9, movetoworkspace, $ws_third_4
