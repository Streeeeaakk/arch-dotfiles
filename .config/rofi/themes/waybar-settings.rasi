/* ============================= */
/* Waybar Settings (No Icons)    */
/* ============================= */

* {
  font: "Figtree 13";

  panel: rgba(12, 14, 18, 0.94);
  text: #e7e7e7;
  muted: #9aa0a6;
  accent: #20D2D7;

  radius: 16px;
}

window {
  location: center;
  anchor: center;

  /* Remove fixed width */
  width: 520px;
  /* Or just remove width entirely */

  background-color: @panel;

  border: 2px;
  border-radius: @radius;
  border-color: rgba(32,210,215,0.85);
}


mainbox {
  padding: 18px;
  spacing: 14px;
  background-color: transparent;
}

/* ===== Search bar (force dark, no white) ===== */
inputbar {
  padding: 10px 14px;
  spacing: 10px;

  border-radius: 12px;
  background-color: rgba(255,255,255,0.06);

  children: [ prompt, entry ];
}

prompt {
  background-color: transparent;
  text-color: @muted;
}

entry {
  background-color: rgba(0,0,0,0);
  text-color: @text;

  placeholder: "Search waybar…";
  placeholder-color: rgba(154,160,166,0.65);
}

textbox {
  background-color: rgba(0,0,0,0);
  text-color: @text;
}
textbox-entry {
  background-color: rgba(0,0,0,0);
  text-color: @text;
}
textbox-prompt-colon {
  background-color: rgba(0,0,0,0);
  text-color: @muted;
}

/* ===== List ===== */
listview {
  lines: 6;
  fixed-height: false;
  spacing: 6px;
  background-color: transparent;
}

element {
  padding: 8px 12px;
  border-radius: 14px;
  background-color: rgba(255,255,255,0.03);
}

element selected {
  background-color: rgba(32,210,215,0.16);
  border: 1px;
  border-color: rgba(32,210,215,0.55);
}

element-text {
  background-color: transparent;
  text-color: @text;
}

/* Kill the icon column completely */
element-icon {
  enabled: false;
  size: 0px;
  margin: 0px;
  padding: 0px;
  background-color: transparent;
}
