[Desktop Entry]
Type=Application
Name=Switch Quickshell Waybar Copy
Comment=Switch Quickshell to Waybar-copy profile
Exec=sh -c "$HOME/.config/hypr/scripts/qs-config-switch.sh waybar-copy"
Icon=preferences-desktop-theme
Terminal=false
Categories=Utility;Settings;
Keywords=quickshell;config;switch;profile;waybar;
